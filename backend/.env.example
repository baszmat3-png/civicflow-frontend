# ==============================================================================
# CivicFlow Backend Environment Configuration
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=production

# Server Port
PORT=5000

# Allowed Frontend URL for CORS & Cookie Domain
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Connection String
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&connection_limit=10
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/civicflow_db?schema=public"

# JWT Security Secrets & Expirations (MUST be replaced with long random strings in production)
JWT_ACCESS_SECRET="generate_a_very_long_secure_random_string_for_access_secret_64_chars"
JWT_ACCESS_EXPIRES_IN="365d"

JWT_REFRESH_SECRET="generate_a_very_long_secure_random_string_for_refresh_secret_64_chars"
JWT_REFRESH_EXPIRES_IN="365d"

# Storage Configuration (local | s3 | cloudinary)
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=25

# WhatsApp Integration (mock | cloud_api)
WHATSAPP_PROVIDER="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ==============================================================================
# Email OTP Verification (optional overrides — safe defaults shown below)
# ==============================================================================
# SMTP credentials used by /auth/send-otp, /auth/verify-otp, /auth/resend-otp
SMTP_HOST=""            # e.g. smtp.gmail.com
SMTP_PORT=587            # 465 for SSL
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""             # optional; defaults to no-reply@civicflow.gov

# OTP security policy
OTP_TTL_MINUTES=10                              # code lifetime (1–60)
OTP_LENGTH=6                                    # digits per code (4–8)
OTP_MAX_ATTEMPTS=5                              # failed tries before lockout
OTP_LOCK_MINUTES=10                             # lockout duration
OTP_RESEND_COOLDOWN_SECONDS=60                  # min interval between sends
OTP_BCRYPT_ROUNDS=10
# TESTING ONLY — never enable in production. Lets the automated test script
# read the generated code from the send/resend response instead of the inbox.
OTP_EXPOSE_IN_RESPONSE="false"
